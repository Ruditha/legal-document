    # Gitignore for the top-level 'legal-document-awareness' project folder

    # Frontend (React Native / Expo) ignores
    /frontend/node_modules/
    /frontend/android/
    /frontend/ios/
    /frontend/.expo/
    /frontend/.expo-shared/
    /frontend/web-build/
    /frontend/dist/
    /frontend/build/

    # Backend (FastAPI / Python) ignores
    /backend/__pycache__/
    /backend/*.pyc
    /backend/*.sqlite3
    /backend/.pytest_cache/
    /backend/.mypy_cache/
    /backend/.venv/              # Common virtual environment name (important!)
    /backend/venv/               # Your virtual environment (CRUCIAL!)
    /backend/log/                # If you have a log folder
    /backend/.env                # Your local backend environment file

    # General ignores for the root of the project
    .env                         # Any root-level .env files
    *.log                        # All log files
    npm-debug.log*
    yarn-debug.log*
    yarn-error.log*

    # IDE and editor specific files
    .idea/                       # IntelliJ/PyCharm/WebStorm IDE specific files
    .vscode/                     # VS Code editor specific files
    *.sublime-project            # Sublime Text project files
    *.sublime-workspace          # Sublime Text workspace files

    # Operating system generated files
    .DS_Store
    Thumbs.db
    