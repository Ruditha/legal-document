# Environment Configuration for Legal Awareness App Backend

# Google Gemini API Configuration (REQUIRED for production)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Application Settings
ENV=development
DEBUG=True

# CORS Settings - Update for your frontend URLs
ALLOWED_ORIGINS=http://localhost:19009,http://localhost:3000,http://localhost:8081

# File Upload Settings
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=png,jpg,jpeg,tiff,bmp

# OCR Settings
OCR_LANGUAGE=eng
OCR_DPI=300

# IMPORTANT: Replace the empty GEMINI_API_KEY with your actual API key before deployment
# This file is configured for development. For production, set ENV=production and DEBUG=False
