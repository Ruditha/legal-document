{
  "expo": {
    "name": "Legal Awareness App",
    "slug": "legal-awareness-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#007bff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.legalawareness.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to camera to capture legal documents for analysis.",
        "NSPhotoLibraryUsageDescription": "This app needs access to photo library to select legal documents for analysis."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#007bff"
      },
      "package": "com.legalawareness.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "webpack"
    },
    "plugins": [
      "expo-image-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to upload legal documents for analysis.",
          "cameraPermission": "The app accesses your camera to capture legal documents for analysis."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8b06c80b-2d1f-46ef-827f-b7d43929587e"
      }
    }
  }
}
